#!/usr/bin/env bash
# Fake oc for the hermetic tests: answers the exact calls the debug-probe
# region of ocp-idle-check.sh makes, with canned data the tests assert on.
#
# Strict by design: an unrecognized invocation exits 1 with a message on
# stderr instead of quietly returning empty output, so when the script's
# oc usage changes, the failure names the call rather than surfacing as a
# confusing jq assertion mismatch downstream.
#
# Decoys: nvidia-dcgm-gdt4p matches a loose /dcgm/ pattern but not the
# exporter name; model-registry-xyz does not match the operator pod regex
# at all. Both must be filtered out by the code under test.
case "$*" in
    # Prometheus route lookup (debug_query_raw)
    *"route thanos-querier"*)
        echo "thanos-querier-test.apps.example.com"
        ;;
    # DCGM exporter discovery (debug_probe_dcgm)
    *"get pods -A"*)
        echo "nvidia-gpu-operator  dcgm-exporter-abc123   1/1  Running  0  8d"
        echo "nvidia-gpu-operator  nvidia-dcgm-gdt4p      1/1  Running  0  8d"
        echo "openshift-monitoring  prometheus-k8s-0       6/6  Running  0  8d"
        ;;
    # Namespace scrape labels (debug_probe_dcgm)
    *"get ns "*)
        echo "NAME                       STATUS  AGE  CLUSTER-MONITORING"
        echo "nvidia-gpu-operator        Active  8d   true"
        ;;
    # Per-node instant snapshot (debug_probe_per_node)
    *"adm top nodes"*)
        echo "ip-10-0-5-50.us-east-2.compute.internal    123m  15  12345Mi  36"
        echo "ip-10-0-60-146.us-east-2.compute.internal   45m   2   9876Mi   9"
        ;;
    # Namespace existence check (debug_probe_criteria); output discarded
    *"get namespace "*)
        exit 0
        ;;
    # Operator pod inventory (debug_probe_criteria)
    *"get pods -n "*)
        echo "rhods-operator-controller-manager-abc  1/1  Running  0  14d"
        echo "rhods-dashboard-xyz                     2/2  Running  1  13d"
        echo "odh-model-controller-manager-qqq        1/1  Running  0  3d"
        echo "model-registry-xyz                      1/1  Running  0  2d"
        ;;
    # Operator event activity (debug_probe_criteria)
    *"get events -n "*)
        for i in $(seq 1 18); do echo "default  Warning  BackOff  Pod  pod-$i  Started container"; done
        echo "default  Normal  SuccessfulCreate  ReplicaSet  rs-1  created pod-a"
        echo "default  Normal  ScalingReplicaSet  Deployment  d-1  scaled up replica set"
        ;;
    *)
        echo "oc-fixture: unrecognized call: oc $*" >&2
        exit 1
        ;;
esac
