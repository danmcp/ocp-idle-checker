#!/usr/bin/env bash
# Fake curl for the hermetic tests: decodes the URL-encoded PromQL query and
# answers it exactly, so a query whose shape changes in the script fails the
# tests loudly instead of silently degrading on a real cluster. The canned
# data replicates build-16 reality: node series carry only the "instance"
# label (no "node"), one node spikes to 41.7% in a single 15m step, the GPU
# idles at 0% utilization with 87% VRAM used, and the api-server verb mix
# is read-heavy (263 reads/s vs 38 writes/s, including server-side APPLY).
urldecode() {
    local s="${1//+/ }"
    printf '%b' "${s//%/\\x}"
}

query=""
for a in "$@"; do
    case "$a" in
        https://*query=*)
            enc="${a##*\?query=}"
            query=$(urldecode "${enc%%&*}")
            ;;
        query=*) query="${a#query=}" ;;
    esac
done

ok() { printf '{"status":"success","data":{"resultType":"vector","result":%s}}' "$1"; }

if [[ "$*" == *"api/v1/query_range"* ]]; then
    # Matrix: node A peaks at 41.7% in one of six 15m steps, node B stays low.
    printf '{"status":"success","data":{"resultType":"matrix","result":[
      {"metric":{"instance":"ip-10-0-5-50.us-east-2.compute.internal:9100"},"values":[[1759900000,"5.1"],[1759900900,"6.2"],[1759901800,"41.7"],[1759902700,"8.3"],[1759903600,"7.9"],[1759904500,"9.4"]]},
      {"metric":{"instance":"ip-10-0-60-146.us-east-2.compute.internal:9100"},"values":[[1759900000,"1.1"],[1759900900,"2.2"],[1759901800,"3.3"],[1759902700,"2.4"],[1759903600,"1.9"],[1759904500,"2.8"]]}
    ]}}'
    exit 0
fi

case "$query" in
    'DCGM_FI_DEV_GPU_UTIL')
        ok '[{"metric":{"gpu":"0","instance":"10.129.0.42:9400","pod":"model-server","namespace":"test"},"value":[1759904500,"0"]}]' ;;
    'max by (gpu) (max_over_time(DCGM_FI_DEV_GPU_UTIL[10080m]))')
        ok '[{"metric":{"gpu":"0"},"value":[1759901800,"17"]}]' ;;
    'avg by (gpu) (avg_over_time(DCGM_FI_DEV_GPU_UTIL[10080m]))')
        ok '[{"metric":{"gpu":"0"},"value":[1759904500,"0.7"]}]' ;;
    'count by (gpu) (count_over_time(DCGM_FI_DEV_GPU_UTIL[10080m]))')
        ok '[{"metric":{"gpu":"0"},"value":[1759904500,"20160"]}]' ;;
    'DCGM_FI_DEV_FB_USED')
        ok '[{"metric":{"gpu":"0","instance":"10.129.0.42:9400","pod":"model-server","namespace":"test"},"value":[1759904500,"42572"]}]' ;;
    'max by (gpu) (max_over_time(DCGM_FI_DEV_FB_USED[10080m]))')
        ok '[{"metric":{"gpu":"0"},"value":[1759901800,"42572"]}]' ;;
    'avg by (gpu) (avg_over_time(DCGM_FI_DEV_FB_USED[10080m]))')
        ok '[{"metric":{"gpu":"0"},"value":[1759904500,"41000"]}]' ;;
    'count(node_cpu_seconds_total)')
        ok '[{"metric":{},"value":[1759904500,"384"]}]' ;;
    '(1 - avg by (node, instance) (rate(node_cpu_seconds_total{mode="idle"}[10080m]))) * 100')
        ok '[{"metric":{"instance":"ip-10-0-5-50.us-east-2.compute.internal:9100"},"value":[1759904500,"15.2"]},{"metric":{"instance":"ip-10-0-60-146.us-east-2.compute.internal:9100"},"value":[1759904500,"2.1"]}]' ;;
    '100 * (1 - avg_over_time((avg by (node, instance) (node_memory_MemAvailable_bytes) / avg by (node, instance) (node_memory_MemTotal_bytes))[10080m:]))')
        ok '[{"metric":{"instance":"ip-10-0-5-50.us-east-2.compute.internal:9100"},"value":[1759904500,"36.1"]},{"metric":{"instance":"ip-10-0-60-146.us-east-2.compute.internal:9100"},"value":[1759904500,"9.4"]}]' ;;
    'count(node:node_cpu_utilisation:ratio_5m)')
        ok '[{"metric":{},"value":[1759904500,"2"]}]' ;;
    'max by (node, instance) (max_over_time(node:node_cpu_utilisation:ratio_5m[10080m])) * 100')
        ok '[{"metric":{"instance":"ip-10-0-5-50.us-east-2.compute.internal:9100"},"value":[1759901800,"39"]},{"metric":{"instance":"ip-10-0-60-146.us-east-2.compute.internal:9100"},"value":[1759900000,"5"]}]' ;;
    'count by (node, instance) (count_over_time(node:node_cpu_utilisation:ratio_5m[10080m]))')
        ok '[{"metric":{"instance":"ip-10-0-5-50.us-east-2.compute.internal:9100"},"value":[1759904500,"2016"]},{"metric":{"instance":"ip-10-0-60-146.us-east-2.compute.internal:9100"},"value":[1759904500,"2015"]}]' ;;
    'sum by (verb) (rate(apiserver_request_total[10080m]))')
        ok '[{"metric":{"verb":"GET"},"value":[1759904500,"230"]},{"metric":{"verb":"LIST"},"value":[1759904500,"20"]},{"metric":{"verb":"WATCH"},"value":[1759904500,"13"]},{"metric":{"verb":"APPLY"},"value":[1759904500,"30"]},{"metric":{"verb":"POST"},"value":[1759904500,"5"]},{"metric":{"verb":"PUT"},"value":[1759904500,"2"]},{"metric":{"verb":"PATCH"},"value":[1759904500,"1"]}]' ;;
    *)
        echo "curl-fixture: unmatched PromQL query: $query" >&2
        exit 1
        ;;
esac
